/target
**/*.rs.bk
.DS_Store
.idea/
.zed/
# VS Code workspace-specific files (not the config directory)
.vscode/*.code-workspace
.vscode/settings.local.json

# Python cache
**/__pycache__/
**/*.py[cod]
**/.pytest_cache
**/.mypy_cache
