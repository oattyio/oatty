{
  "name": "oatty",
  "version": "0.1.12",
  "description": "API access for agents through MCP and OpenAPI, with a shared terminal command catalog",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oattyio/oatty.git"
  },
  "homepage": "https://oatty.io/docs/api-access",
  "bugs": {
    "url": "https://github.com/oattyio/oatty/issues"
  },
  "bin": {
    "oatty": "npm/bin/oatty.js"
  },
  "files": [
    "npm/bin",
    "npm/scripts",
    "README.md",
    "LICENSE*",
    "THIRD-PARTY-NOTICES.txt",
    "third-party-licenses",
    "third-party-sources"
  ],
  "scripts": {
    "postinstall": "node npm/scripts/postinstall.js",
    "licenses:prepare": "python3 scripts/licenses.py prepare",
    "licenses:verify": "python3 scripts/licenses.py verify",
    "test:licenses": "python3 -m unittest discover -s scripts/tests -v",
    "prepack": "python3 scripts/licenses.py verify"
  },
  "keywords": [
    "cli",
    "tui",
    "mcp",
    "openapi",
    "workflow"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "tar": "^7.4.3"
  }
}
